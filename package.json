{
  "name": "ghost-writer",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pack:minitool": "npm run build && node scripts/check-minitool.mjs dist && mkdir -p release && cd dist && zip -r -X \"../release/ghost-writer-minitool-v$npm_package_version.zip\" . -x '*.DS_Store' -x '*.map'"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
